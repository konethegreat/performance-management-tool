# PostgreSQL connection (matches docker-compose.yml)
DATABASE_URL="postgresql://pms:pms@localhost:5432/mostoeneng_pms?schema=public"

# JWT signing secret — change in any real deployment
JWT_SECRET="dev-secret-change-me"
JWT_EXPIRES_IN="8h"

# API port
PORT=4000

# Allowed frontend origin for CORS
CLIENT_ORIGIN="http://localhost:5173"

# ── AI (Anthropic) ──
# The AI layer is optional. With AI_ENABLED="false" or no key, the app runs
# normally and AI features show an "AI not configured" state.
AI_ENABLED="true"
ANTHROPIC_API_KEY=""           # paste your key in .env (gitignored), not here

# Tiered model routing — each task uses the right model by default. Override a
# tier only if you want to; leave blank to use the defaults shown.
AI_MODEL_FAST=""               # default: claude-haiku-4-5-20251001 (bias/quality check)
AI_MODEL_BALANCED=""           # default: claude-sonnet-4-6        (review organizer)
AI_MODEL_DEEP=""               # default: claude-opus-4-8          (report draft, memory)

# Optional global pin: set AI_MODEL to force ALL tasks onto one model (cost
# control / testing). Leave unset to keep per-task tiered routing.
# AI_MODEL="claude-opus-4-8"

# ── Home widgets (free public APIs, proxied server-side) ──
HOLIDAY_COUNTRY="ZA"           # ISO country for public holidays (Nager.Date)
OFFICE_LAT="-26.2041"          # office latitude for the weather widget (Open-Meteo)
OFFICE_LON="28.0473"           # office longitude (default: Johannesburg)
