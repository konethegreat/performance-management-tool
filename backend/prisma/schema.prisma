// Mostoeneng Attorney Performance Management System — data model
// ORM: Prisma  |  DB: PostgreSQL
//
// Design notes:
//  - A PracticeGroup is where a review "starts" (group -> draft -> approved).
//  - A ReviewCycle is a time window (QUARTERLY or ANNUAL) the firm runs.
//  - A PerformanceReview is one attorney's review within one cycle. The attorney
//    "launches" it (launchedAt) which fans out FeedbackRequests to the 360 sources.
//  - FeedbackResponse holds per-competency Ratings + comments from one reviewer.
//  - Goals/DevelopmentPlan capture the "improve them / hold accountable" half.
//  - ReportEvent is the immutable audit trail of state transitions.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────  ENUMS  ─────────────────────────────

enum Role {
  ADMIN
  MANAGER
  ATTORNEY
  SUPPORT // support staff (paralegal/secretary/typist) — social/soft raters only
  CLIENT
}

enum CycleType {
  QUARTERLY
  ANNUAL
}

enum CycleStatus {
  OPEN       // accepting launches
  CLOSED     // window over
}

enum ReviewStatus {
  NOT_STARTED // created but attorney hasn't launched
  LAUNCHED    // attorney pressed launch; feedback being collected
  DRAFT       // manager is drafting the report
  IN_REVIEW   // submitted up the chain
  FINALIZED   // manager finalized; awaiting approval
  APPROVED    // immutable, feeds annual rollup
}

// Who is giving feedback — the 360 sources.
enum ReviewerRole {
  SELF
  MANAGER
  PEER
  SUBORDINATE
  SUPPORT // support staff (paralegal/secretary/typist) — rate social/soft competencies only
  CLIENT
}

enum RequestStatus {
  PENDING
  SUBMITTED
  DECLINED
}

enum GoalStatus {
  OPEN
  IN_PROGRESS
  ACHIEVED
  MISSED
}

// Lightweight continuous feedback given between formal review cycles.
enum FeedbackKind {
  PRAISE // positive recognition / kudos
  NOTE   // a quick constructive observation
}

// ─────────────────────────────  CORE  ─────────────────────────────

model PracticeGroup {
  id        String   @id @default(cuid())
  name      String   @unique // e.g. "Corporate & Commercial"
  headId    String?  // the partner/manager who heads the group
  head      User?    @relation("GroupHead", fields: [headId], references: [id])
  members   User[]   @relation("GroupMembers")
  createdAt DateTime @default(now())
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  role         Role
  title        String? // human label, e.g. "Senior Associate" (usually the position's label)
  position     String? // catalog key from lib/positions.js; derives role tier + capabilities
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  // Org structure
  managerId String?
  manager   User?   @relation("Reports", fields: [managerId], references: [id])
  reports   User[]  @relation("Reports")

  practiceGroupId String?
  practiceGroup   PracticeGroup? @relation("GroupMembers", fields: [practiceGroupId], references: [id])
  headedGroups    PracticeGroup[] @relation("GroupHead")

  // Client-specific: which firm/account this client belongs to
  clientAccount String?

  // Reviews where this user is the subject (the attorney being reviewed)
  reviewsAsSubject PerformanceReview[] @relation("ReviewSubject")
  // Reviews where this user is the assigned manager/owner of the report
  reviewsAsManager PerformanceReview[] @relation("ReviewManager")

  // Feedback this user has been asked to give
  feedbackRequests FeedbackRequest[] @relation("Reviewer")

  goals      Goal[]
  events     ReportEvent[]

  // AI memory profile (one per attorney) + in-app notifications
  memory        AttorneyMemory? @relation("AttorneyMemory")
  notifications Notification[]  @relation("UserNotifications")

  // Continuous feedback (praise/notes) given and received, between formal cycles
  feedbackGiven    ContinuousFeedback[] @relation("FeedbackAuthor")
  feedbackReceived ContinuousFeedback[] @relation("FeedbackRecipient")
  // 1:1 meeting logs as the manager, and as the report
  oneOnOnesAsManager OneOnOne[] @relation("OneOnOneManager")
  oneOnOnesAsReport  OneOnOne[] @relation("OneOnOneReport")
}

model ReviewCycle {
  id          String      @id @default(cuid())
  name        String // e.g. "Q2 2026", "FY2026 Annual"
  type        CycleType
  periodStart DateTime
  periodEnd   DateTime
  // Target turnaround in days from launch -> approved (SLA against cadence)
  slaDays     Int         @default(30)
  status      CycleStatus @default(OPEN)
  // For an ANNUAL cycle, the quarterly cycles that roll up into it
  parentId    String?
  parent      ReviewCycle?  @relation("CycleRollup", fields: [parentId], references: [id])
  children    ReviewCycle[] @relation("CycleRollup")
  createdAt   DateTime    @default(now())

  reviews PerformanceReview[]

  @@unique([name, type])
}

model Competency {
  id          String  @id @default(cuid())
  name        String  @unique // "Legal Knowledge", "Client Service", ...
  category    String // "Technical", "Client", "Business", "Behavioural"
  description String
  // Relative weight in the composite score (e.g. 1.0 default, 1.5 important)
  weight      Float   @default(1.0)
  active      Boolean @default(true)
  order       Int     @default(0)

  ratings Rating[]
}

model PerformanceReview {
  id        String       @id @default(cuid())
  subjectId String
  subject   User         @relation("ReviewSubject", fields: [subjectId], references: [id])
  cycleId   String
  cycle     ReviewCycle  @relation(fields: [cycleId], references: [id])
  managerId String // owns the draft/approval
  manager   User         @relation("ReviewManager", fields: [managerId], references: [id])

  status ReviewStatus @default(NOT_STARTED)

  // The "launch button" timestamp — the spine of cadence/SLA analytics
  launchedAt  DateTime?
  submittedAt DateTime? // moved to IN_REVIEW
  finalizedAt DateTime?
  approvedAt  DateTime?

  // Manager's narrative report
  draftSummary  String? @db.Text
  finalSummary  String? @db.Text
  // AI-generated draft (kept separate from the human-authored draftSummary)
  aiDraftSummary String? @db.Text
  // Composite score (computed + weighted across submitted feedback)
  overallScore  Float?

  requests FeedbackRequest[]
  goals    Goal[]
  events   ReportEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([subjectId, cycleId])
  @@index([status])
}

model FeedbackRequest {
  id         String        @id @default(cuid())
  reviewId   String
  review     PerformanceReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reviewerId String
  reviewer   User          @relation("Reviewer", fields: [reviewerId], references: [id])
  reviewerRole ReviewerRole
  status     RequestStatus @default(PENDING)
  dueDate    DateTime?
  createdAt  DateTime      @default(now())

  response FeedbackResponse?

  @@unique([reviewId, reviewerId, reviewerRole])
  @@index([reviewerId, status])
}

model FeedbackResponse {
  id          String   @id @default(cuid())
  requestId   String   @unique
  request     FeedbackRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  // Free-text strengths / areas to improve
  strengths   String?  @db.Text
  improvements String? @db.Text
  // AI-structured version of this feedback (JSON string), set by the Review Organizer
  organized   String?  @db.Text
  // Source-level confidence weight (e.g. client capped lower) — set at fan-out
  sourceWeight Float   @default(1.0)
  submittedAt DateTime @default(now())

  ratings Rating[]
}

model Rating {
  id           String   @id @default(cuid())
  responseId   String
  response     FeedbackResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  competencyId String
  competency   Competency @relation(fields: [competencyId], references: [id])
  score        Int      // 1..5
  comment      String?

  @@unique([responseId, competencyId])
}

// An OKR objective. Measurable progress lives in its KeyResults and rolls up as
// their average; `status` is the coarse lifecycle the owner/manager sets.
model Goal {
  id          String     @id @default(cuid())
  // A goal can hang off a specific review or just off the attorney
  reviewId    String?
  review      PerformanceReview? @relation(fields: [reviewId], references: [id], onDelete: SetNull)
  ownerId     String
  owner       User       @relation(fields: [ownerId], references: [id])
  // Who created it. If different from ownerId, a manager assigned it.
  createdById String?
  title       String
  description String?    @db.Text
  status      GoalStatus @default(OPEN)
  dueDate     DateTime?
  keyResults  KeyResult[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

// A measurable result under an objective. progress is a 0–100 percent; the
// parent objective's progress is the average of its key results.
model KeyResult {
  id        String   @id @default(cuid())
  goalId    String
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  title     String
  progress  Int      @default(0) // 0..100
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([goalId])
}

// Continuous feedback: a single praise/note from one person to another, outside
// the formal 360 cycle. Visible to the recipient and their manager (+ author, admin).
model ContinuousFeedback {
  id          String       @id @default(cuid())
  authorId    String
  author      User         @relation("FeedbackAuthor", fields: [authorId], references: [id])
  recipientId String
  recipient   User         @relation("FeedbackRecipient", fields: [recipientId], references: [id])
  kind        FeedbackKind @default(PRAISE)
  body        String       @db.Text
  createdAt   DateTime     @default(now())

  @@index([recipientId, createdAt])
  @@index([authorId])
}

// A lightweight 1:1 meeting log between a manager and a report. `notes` is shared
// — both the manager and the report can read it.
model OneOnOne {
  id          String   @id @default(cuid())
  managerId   String
  manager     User     @relation("OneOnOneManager", fields: [managerId], references: [id])
  reportId    String
  report      User     @relation("OneOnOneReport", fields: [reportId], references: [id])
  heldOn      DateTime @default(now())
  notes       String   @db.Text
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([reportId, heldOn])
  @@index([managerId, heldOn])
}

// Immutable audit trail of report state transitions / actions
model ReportEvent {
  id        String   @id @default(cuid())
  reviewId  String
  review    PerformanceReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  action    String // "LAUNCHED", "DRAFT_SAVED", "SUBMITTED", "FINALIZED", "APPROVED", "SENT_BACK"
  note      String?
  createdAt DateTime @default(now())

  @@index([reviewId])
}

// ─────────────────────────────  AI / NOTIFICATIONS  ─────────────────────────────

// A persistent, AI-maintained longitudinal profile of one attorney, refreshed
// when a report is APPROVED and fed into the Report Draft Assistant.
model AttorneyMemory {
  id          String   @id @default(cuid())
  attorneyId  String   @unique
  attorney    User     @relation("AttorneyMemory", fields: [attorneyId], references: [id], onDelete: Cascade)
  summary     String?  @db.Text
  themes      String?  @db.Text // JSON string array of recurring themes
  strengths   String?  @db.Text
  risks       String?  @db.Text // watch areas
  trajectory  String?  @db.Text // performance direction over cycles
  lastCycleId String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

// In-app notification (feedback requested, state change, approval, etc.)
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  type      String // FEEDBACK_REQUESTED | STATE_CHANGE | APPROVED | SENT_BACK | ...
  message   String
  link      String? // e.g. /reviews/:id or /feedback
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

// Audit row for every AI call (cost + transparency for an AI-run PMS).
model AiRun {
  id           String   @id @default(cuid())
  kind         String // ORGANIZE | BIAS_CHECK | DRAFT | MEMORY
  model        String
  refId        String? // review / request / attorney id
  actorId      String?
  inputTokens  Int?
  outputTokens Int?
  createdAt    DateTime @default(now())

  @@index([kind, createdAt])
}
